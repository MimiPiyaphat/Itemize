# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.venv-gpu/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ==========================================
# IDE & OS
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Data, Results & Heavy Binary Assets
# Keep directory layout via .gitkeep, sync heavy files via Drive/OneDrive/LAN
# ==========================================
data/**/*
!data/**/
!data/**/.gitkeep

results/**/*
!results/**/
!results/**/.gitkeep

# Common media & 3D mesh files outside tracked docs
*.glb
*.gltf
*.obj
*.mtl
*.ply
*.fbx
*.stl
*.mp4
*.mov

# ==========================================
# Model Weights & Third-Party Cloned Repos
# ==========================================
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
weights/
checkpoints/

third_party/**/*
!third_party/**/
!third_party/**/.gitkeep

